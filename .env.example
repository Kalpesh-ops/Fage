# Copy to .env (never commit .env). Only the keys you have are needed; the pipeline runs fully with --offline.

# Primary provider: Google AI Studio (Gemini 2.5 Flash)
GEMINI_API_KEY=

# Fallback provider: OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=

# Optional model overrides (defaults: gemini-3.6-flash / google/gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash
# OPENROUTER_MODEL=google/gemini-3.6-flash
# Optional price overrides for the usage report (USD per 1M tokens). OpenRouter defaults to its published rate for
# google/gemini-3.6-flash (0.75 in / 3.75 out, read 2026-09-13); no direct-Gemini rate is assumed unless set here.
# GEMINI_PRICE_IN_PER_M=
# GEMINI_PRICE_OUT_PER_M=
# OPENROUTER_PRICE_IN_PER_M=0.75
# OPENROUTER_PRICE_OUT_PER_M=3.75

# Client-side rate limits (requests per minute) per provider
GEMINI_RPM=8
OPENROUTER_RPM=15
